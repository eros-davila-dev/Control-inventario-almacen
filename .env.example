# Copie este archivo como .env y reemplace los valores. El archivo .env no se
# versiona (ver .gitignore): las credenciales reales nunca entran al repositorio.

# Base de datos PostgreSQL 17
POSTGRES_DB=sgai
POSTGRES_USER=sgai
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_PORT=5432

# Secreto de firma de los JWT: minimo 64 caracteres aleatorios.
# Generarlo con: openssl rand -base64 64
SGAI_JWT_SECRET=reemplace-por-un-secreto-aleatorio-de-al-menos-64-caracteres-xxxxxxxx

# Origenes autorizados para CORS (separados por coma)
SGAI_CORS_ORIGINS=http://localhost:8081

# Puertos publicados en el host
API_PORT=8080
WEB_PORT=8081
